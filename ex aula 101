#include <stdlib.h>
#include <stdio.h>
#include <string.h>

int main()
{
    int i;
    int num2[10];
    
    for(i = 0; i < 10; i++){
        printf("Digite o elemento da posicao %d: ", i);
        scanf("%d", &num2[i]);
    }
    
    for(i = 0; i< 10; i++){
        num2[i] = num2[i] * 3;
    }
    
    printf("\n");
    
    for(i = 0; i < 10; i++){
        printf("%d ", num2[i]);
    }
    return 0;
}
