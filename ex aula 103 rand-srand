#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <time.h>

int main()
{
    int i;
    int num2[10];
    
    srand(time(NULL));
    
    for(i = 0; i < 10; i++){
        num2[i] = rand();
    }

    printf("\n");
    for(i = 0; i < 10; i++){
        printf("%d ", num2[i]);
    }
    return 0;
}
